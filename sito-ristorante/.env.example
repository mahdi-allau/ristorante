# URL pubblico del sito (senza slash finale). Usato per sitemap, canonical, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 (caricato SOLO dopo il consenso cookie). Lascia vuoto per disattivare.
NEXT_PUBLIC_GA_ID=

# Supabase (prenotazioni reali). Senza queste variabili il sito funziona in modalità DEMO.
# La chiave service_role resta SOLO sul server: mai NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email di conferma). Senza chiave le email non vengono inviate.
RESEND_API_KEY=
RESEND_FROM="Osteria Lumina <prenotazioni@tuodominio.it>"
OWNER_EMAIL=prenotazioni@tuodominio.it

# Coperti massimi prenotabili per fascia oraria
SEATS_PER_SLOT=24

# Pannello /admin per il ristoratore. Senza queste due variabili il pannello è disattivato.
# ADMIN_SECRET: stringa casuale di almeno 24 caratteri (es. `openssl rand -hex 32`).
ADMIN_PASSWORD=
ADMIN_SECRET=

# Stripe (gift card). Usa prima le chiavi di TEST (sk_test_…, whsec_… del webhook in modalità test).
# Webhook da registrare nel dashboard Stripe: https://tuodominio.it/api/stripe/webhook
#   eventi: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Solo sviluppo: se 1, l'acquisto gift card funziona SENZA pagamento (carta attivata subito). MAI in produzione.
GIFT_CARD_DEMO=
GIFT_MIN_EUR=20
GIFT_MAX_EUR=500

# Promemoria prenotazioni (email 24 ore prima con link per confermare/annullare).
# CRON_SECRET: stringa casuale di almeno 16 caratteri. Lo scheduler (Vercel Cron, funzione Netlify inclusa,
# cron-job.org…) chiama ogni ora POST /api/cron/reminders con l'header "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Solo sviluppo: BOOKING_STORE=file salva le prenotazioni in data/bookings.json; EMAIL_OUTBOX=1 scrive le email in data/outbox/.
BOOKING_STORE=
EMAIL_OUTBOX=

# Richieste di recensione dopo la visita (email unica, stesso messaggio per tutti, mai incentivi né filtro sui clienti scontenti).
# GOOGLE_REVIEW_URL: link diretto "scrivi una recensione" del profilo Google (da Google Business Profile → "Chiedi recensioni"),
# es. https://g.page/r/XXXXXXXX/review. Senza questo link la funzione è spenta.
GOOGLE_REVIEW_URL=
# Chi riceve la richiesta: opt_in (predefinito: solo chi ha spuntato la casella) oppure all_seated (tutti gli ospiti serviti:
# da usare solo dopo conferma legale). In ogni caso la disiscrizione in un clic resta attiva.
REVIEW_AUDIENCE=opt_in
# Fascia oraria di invio (ora di Roma), ore di attesa dopo l'orario della prenotazione e limite oltre il quale non si invia più
REVIEW_SEND_HOURS=9-21
REVIEW_DELAY_HOURS=3
REVIEW_MAX_AGE_HOURS=72
